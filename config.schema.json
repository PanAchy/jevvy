{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PanAchy/jevvy/main/config.schema.json",
  "title": "Jevvy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": ["zen", "typesafe", "openrouter", "vercel", "openai", "microsoft", "laya", "custom"]
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zen": {
          "$ref": "#/$defs/systemOnePresetSettings"
        },
        "typesafe": {
          "$ref": "#/$defs/systemOnePresetSettings"
        },
        "openrouter": {
          "$ref": "#/$defs/systemOnePresetSettings"
        },
        "vercel": {
          "$ref": "#/$defs/systemOnePresetSettings"
        },
        "openai": {
          "$ref": "#/$defs/providerCredential"
        },
        "microsoft": {
          "$ref": "#/$defs/microsoftProvider"
        },
        "laya": {
          "$ref": "#/$defs/layaProvider"
        },
        "custom": {
          "$ref": "#/$defs/customSystemOneProvider"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewAskPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "OpenCode only. Exact resource-pattern strings of winning ask rules Jevvy Permissions may review for shell requests. Entries identify rules, not commands, and apply across effective agent and session rules. The existing shell catch-all invitation stays enabled. Reload OpenCode after changing this list."
        },
        "timeoutMs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 5000,
          "description": "Jevvy review timeout in milliseconds. Host deadlines may end the request sooner."
        },
        "opencode": {
          "$ref": "#/$defs/harnessReview"
        },
        "claude": {
          "$ref": "#/$defs/harnessReview"
        },
        "questions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/approvalQuestion"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "laya"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "not": {
          "required": ["permissions"],
          "properties": {
            "permissions": {
              "required": ["questions"]
            }
          }
        },
        "required": ["providers"],
        "properties": {
          "providers": {
            "required": ["laya"],
            "properties": {
              "laya": {
                "required": ["policy"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "custom"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "required": ["providers"],
        "properties": {
          "providers": {
            "required": ["custom"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "provider": { "const": "microsoft" } },
        "required": ["provider"]
      },
      "then": {
        "required": ["providers"],
        "properties": { "providers": { "required": ["microsoft"] } }
      }
    }
  ],
  "$defs": {
    "providerCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiKey"],
      "properties": {
        "apiKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "harnessReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Jevvy review for this harness. Disabled review leaves host permission handling unchanged."
        }
      }
    },
    "systemOnePresetSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiKey": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "opencodeCredential": {
          "type": "string",
          "minLength": 1,
          "description": "OpenCode integration ID whose stored API key Jevvy reads when apiKey and the provider environment variable are absent. OpenCode only."
        }
      }
    },
    "approvalQuestions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/approvalQuestion"
      }
    },
    "customSystemOneProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "model"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "apiKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "microsoftProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "model"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/@?#]+(?:/|$)",
          "description": "Full Foundry inference URL ending in /providers/microsoft/v1/systemone."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Your Microsoft-Decision-1 deployment name, not the catalog model ID."
        },
        "apiKey": {
          "type": "string",
          "minLength": 1,
          "description": "Azure AI API key sent in the api-key header. Alternatively set AZURE_AI_API_KEY."
        }
      }
    },
    "layaProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "enum": ["english", "multilingual", "typed-decisions"]
        },
        "apiKey": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint", "questions"],
          "properties": {
            "checkpoint": {
              "type": "string",
              "enum": ["english", "multilingual", "typed-decisions"]
            },
            "questions": {
              "$ref": "#/$defs/approvalQuestions"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "model": { "const": "english" } }
          },
          "then": {
            "properties": { "policy": { "properties": { "checkpoint": { "const": "english" } } } }
          }
        },
        {
          "if": {
            "required": ["model"],
            "properties": { "model": { "const": "multilingual" } }
          },
          "then": {
            "properties": { "policy": { "properties": { "checkpoint": { "const": "multilingual" } } } }
          }
        },
        {
          "if": {
            "required": ["model"],
            "properties": { "model": { "const": "typed-decisions" } }
          },
          "then": {
            "properties": { "policy": { "properties": { "checkpoint": { "const": "typed-decisions" } } } }
          }
        }
      ]
    },
    "approvalQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions", "threshold"],
      "properties": {
        "type": {
          "const": "noul"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": ["false", "true"],
          "properties": {
            "false": {
              "type": "string",
              "minLength": 1
            },
            "true": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
