{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PanAchy/jevvy/main/config.schema.json",
  "title": "Jevvy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": ["zen", "typesafe", "openrouter", "vercel", "laya", "custom"]
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zen": {
          "$ref": "#/$defs/providerCredential"
        },
        "typesafe": {
          "$ref": "#/$defs/providerCredential"
        },
        "openrouter": {
          "$ref": "#/$defs/providerCredential"
        },
        "vercel": {
          "$ref": "#/$defs/providerCredential"
        },
        "laya": {
          "$ref": "#/$defs/layaProvider"
        },
        "custom": {
          "$ref": "#/$defs/customSystemOneProvider"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/approvalQuestion"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "laya"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "not": {
          "required": ["permissions"],
          "properties": {
            "permissions": {
              "required": ["questions"]
            }
          }
        },
        "required": ["providers"],
        "properties": {
          "providers": {
            "required": ["laya"],
            "properties": {
              "laya": {
                "required": ["policy"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "custom"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "required": ["providers"],
        "properties": {
          "providers": {
            "required": ["custom"]
          }
        }
      }
    }
  ],
  "$defs": {
    "providerCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiKey"],
      "properties": {
        "apiKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approvalQuestions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/approvalQuestion"
      }
    },
    "customSystemOneProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "model"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "apiKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layaProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "enum": ["english", "multilingual", "typed-decisions"]
        },
        "apiKey": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint", "questions"],
          "properties": {
            "checkpoint": {
              "type": "string",
              "enum": ["english", "multilingual", "typed-decisions"]
            },
            "questions": {
              "$ref": "#/$defs/approvalQuestions"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "model": { "const": "english" } }
          },
          "then": {
            "properties": { "policy": { "properties": { "checkpoint": { "const": "english" } } } }
          }
        },
        {
          "if": {
            "required": ["model"],
            "properties": { "model": { "const": "multilingual" } }
          },
          "then": {
            "properties": { "policy": { "properties": { "checkpoint": { "const": "multilingual" } } } }
          }
        },
        {
          "if": {
            "required": ["model"],
            "properties": { "model": { "const": "typed-decisions" } }
          },
          "then": {
            "properties": { "policy": { "properties": { "checkpoint": { "const": "typed-decisions" } } } }
          }
        }
      ]
    },
    "approvalQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions", "threshold"],
      "properties": {
        "type": {
          "const": "noul"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": ["false", "true"],
          "properties": {
            "false": {
              "type": "string",
              "minLength": 1
            },
            "true": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
