{
  "name": "@jevvy/permissions",
  "version": "0.7.0",
  "description": "Jev-powered auto-approval for harmless shell permission requests",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/PanAchy/jevvy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PanAchy/jevvy.git",
    "directory": "packages/permissions"
  },
  "bugs": {
    "url": "https://github.com/PanAchy/jevvy/issues"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "plugin",
    "permissions",
    "agent",
    "jev",
    "system-one"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": "./dist/opencode/tui.js"
  },
  "bin": {
    "jevvy": "bin/jevvy.mjs",
    "permissions": "bin/jevvy.mjs",
    "jevvy-calibrate": "bin/jevvy-calibrate.mjs",
    "jevvy-claude-hook": "dist/claude-hook.js"
  },
  "files": [
    ".claude-plugin",
    "dist",
    "bin",
    "hooks",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace=@jevvy/core && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-permissions.mjs && node ../../scripts/copy-calibration-assets.mjs",
    "prepack": "npm run build && node ../../scripts/package-readme.mjs prepare",
    "postpack": "node ../../scripts/package-readme.mjs clean"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@effect/sql-sqlite-bun": "4.0.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "@opencode/plugin": "2.1.3",
    "effect": "4.0.1",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "4.1.2",
    "string-width": "^8.3.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
