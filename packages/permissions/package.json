{
  "name": "@jevvy/permissions",
  "version": "0.4.0",
  "description": "Jev-powered auto-approval for harmless shell permission requests",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/PanAchy/jevvy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PanAchy/jevvy.git",
    "directory": "packages/permissions"
  },
  "bugs": {
    "url": "https://github.com/PanAchy/jevvy/issues"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "plugin",
    "permissions",
    "agent",
    "jev",
    "system-one"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "jevvy": "bin/jevvy.mjs",
    "permissions": "bin/jevvy.mjs",
    "jevvy-calibrate": "bin/jevvy-calibrate.mjs",
    "jevvy-claude-hook": "dist/claude-hook.js"
  },
  "files": [
    ".claude-plugin",
    "dist",
    "bin",
    "hooks",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace=@jevvy/core && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && esbuild src/core.ts --bundle --platform=node --format=esm --target=node22 --external:effect --external:effect/* --outfile=dist/core.js && esbuild src/claude/main.ts --bundle --platform=node --format=esm --target=node22 --main-fields=module,main --outfile=dist/claude-hook.js && node ../../scripts/copy-calibration-assets.mjs",
    "prepack": "npm run build && node ../../scripts/package-readme.mjs prepare",
    "postpack": "node ../../scripts/package-readme.mjs clean"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@opencode/plugin": "2.0.8",
    "effect": "4.0.0-rc.112",
    "jsonc-parser": "^3.3.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
