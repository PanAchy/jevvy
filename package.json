{
  "name": "jevvy-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:permissions",
    "build:core": "npm run build --workspace=@jevvy/core",
    "build:permissions": "npm run build --workspace=@jevvy/permissions",
    "calibrate": "npm run build && node eval/calibrate.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check": "npm run typecheck && npm run lint:check && npm test && npm run build",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "pretest": "npm run build:core",
    "pretypecheck": "npm run build:core",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:claude": "node scripts/claude-smoke.mjs",
    "smoke:opencode": "node scripts/opencode-smoke.mjs",
    "smoke": "npm run smoke:package && npm run smoke:opencode && npm run smoke:claude",
    "test": "vitest run",
    "test:watch": "npm run build:core && vitest",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/permissions/tsconfig.json && npm run typecheck:scripts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^22.20.3",
    "@types/proper-lockfile": "4.1.4",
    "effect": "4.0.1",
    "esbuild": "^0.25.10",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "solid-js": "1.9.12",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "overrides": {
    "solid-js@1.9.12": {
      "seroval": "1.6.9"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
