{
  "name": "jevvy",
  "version": "0.1.0-alpha.1",
  "description": "Judged permissions for coding agents: Jev (TypeSafe System One) verdicts, allow or ask, never deny",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "permissions",
    "agent",
    "jev",
    "typesafe",
    "ai-safety"
  ],
  "homepage": "https://github.com/PanAchy/jevvy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PanAchy/jevvy.git"
  },
  "bugs": {
    "url": "https://github.com/PanAchy/jevvy/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "jevvy": "bin/jevvy.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "calibrate": "npm run build && node eval/calibrate.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "eval:analyze": "node eval/analyze.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "prepublishOnly": "npm run build",
  "dependencies": {
    "@opencode/client": "2.0.8",
    "@opencode/plugin": "2.0.8",
    "@opencode/schema": "^2.0.8",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^17.4.2",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^22.20.3",
    "oxlint": "1.83.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
